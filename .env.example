# Copiar a .env y completar con tus valores
# copy .env.example .env

# App
APP_NAME=Profimar
DEBUG=false

# SQL Server (pyodbc)
# Instancia nombrada (ej. SQLEXPRESS): usar MSSQL_PORT=0
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_PORT=0
MSSQL_DATABASE=profimar
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Opción 1: Autenticación Windows (recomendado en desarrollo local)
MSSQL_USE_WINDOWS_AUTH=true
MSSQL_USER=
MSSQL_PASSWORD=

# Opción 2: Autenticación SQL (descomentar y comentar la opción 1)
# MSSQL_USE_WINDOWS_AUTH=false
# MSSQL_USER=sa
# MSSQL_PASSWORD=tu_password
